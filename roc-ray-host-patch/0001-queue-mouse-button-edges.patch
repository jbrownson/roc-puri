+    enqueueMouseEdge(.{ .button = 0, .pressed = false });
+
+    try std.testing.expectEqual(MouseEdge{ .button = 0, .pressed = true }, dequeueMouseEdge().?);
+    try std.testing.expectEqual(MouseEdge{ .button = 0, .pressed = false }, dequeueMouseEdge().?);
+    try std.testing.expect(dequeueMouseEdge() == null);
@@ -453,0 +557 @@ pub fn initWindow(width: c_int, height: c_int, title: [*:0]const u8) void {
+    installMouseEdgeCapture();
