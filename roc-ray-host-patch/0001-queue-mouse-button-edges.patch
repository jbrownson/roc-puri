+/// Raylib exposes mouse input as a once-per-frame state snapshot. If GLFW
+/// reports a press and release during the same poll, that snapshot ends in the
+/// up state and both edges disappear. Capture the GLFW callback before Raylib
+/// collapses it and replay at most one edge into each Roc frame.
+const GlfwWindow = opaque {};
+const GlfwMouseButtonCallback = ?*const fn (?*GlfwWindow, c_int, c_int, c_int) callconv(.c) void;
+
+extern fn glfwGetCurrentContext() ?*GlfwWindow;
+extern fn glfwSetMouseButtonCallback(?*GlfwWindow, GlfwMouseButtonCallback) GlfwMouseButtonCallback;
+
+const GLFW_RELEASE: c_int = 0;
+const GLFW_PRESS: c_int = 1;
+const MOUSE_EDGE_QUEUE_CAPACITY: usize = 64;
+
+const MouseEdge = struct {
+    button: usize,
+    pressed: bool,
+};
+
+var mouse_edge_queue: [MOUSE_EDGE_QUEUE_CAPACITY]MouseEdge = undefined;
+var mouse_edge_head: usize = 0;
+var mouse_edge_len: usize = 0;
+var raylib_mouse_button_callback: GlfwMouseButtonCallback = null;
+var mouse_edge_capture_installed = false;
+
+fn resetMouseEdgeQueue() void {
+    mouse_edge_head = 0;
+    mouse_edge_len = 0;
+}
+
+fn enqueueMouseEdge(edge: MouseEdge) void {
+    if (mouse_edge_len == MOUSE_EDGE_QUEUE_CAPACITY) return;
+    const tail = (mouse_edge_head + mouse_edge_len) % MOUSE_EDGE_QUEUE_CAPACITY;
+    mouse_edge_queue[tail] = edge;
+    mouse_edge_len += 1;
+}
+
+fn dequeueMouseEdge() ?MouseEdge {
+    if (mouse_edge_len == 0) return null;
+    const edge = mouse_edge_queue[mouse_edge_head];
+    mouse_edge_head = (mouse_edge_head + 1) % MOUSE_EDGE_QUEUE_CAPACITY;
+    mouse_edge_len -= 1;
+    return edge;
+}
+
+fn captureMouseButtonEdge(window: ?*GlfwWindow, button: c_int, action: c_int, mods: c_int) callconv(.c) void {
+    if (raylib_mouse_button_callback) |callback| callback(window, button, action, mods);
+
+    if (button < 0) return;
+    const index: usize = @intCast(button);
+    if (index >= ffi.MOUSE_BUTTON_COUNT) return;
+
+    if (action == GLFW_PRESS) {
+        enqueueMouseEdge(.{ .button = index, .pressed = true });
+    } else if (action == GLFW_RELEASE) {
+        enqueueMouseEdge(.{ .button = index, .pressed = false });
+    }
+}
+
+fn installMouseEdgeCapture() void {
+    const window = glfwGetCurrentContext() orelse return;
+    resetMouseEdgeQueue();
+    raylib_mouse_button_callback = glfwSetMouseButtonCallback(window, &captureMouseButtonEdge);
+    mouse_edge_capture_installed = true;
+}
+
+fn uninstallMouseEdgeCapture() void {
+    if (!mouse_edge_capture_installed) return;
+    const window = glfwGetCurrentContext() orelse return;
+    _ = glfwSetMouseButtonCallback(window, raylib_mouse_button_callback);
+    raylib_mouse_button_callback = null;
+    mouse_edge_capture_installed = false;
+    resetMouseEdgeQueue();
+}
+
@@ -59,2 +134,2 @@ pub fn updateMouseButtonState() void {
-        mouse_button_pressed_state[i] = if (rl.IsMouseButtonPressed(button)) 1 else 0;
-        mouse_button_released_state[i] = if (rl.IsMouseButtonReleased(button)) 1 else 0;
